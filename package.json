{
  "name": "copyhaunt-ads",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ad intelligence para a Biblioteca de Anúncios da Meta",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
